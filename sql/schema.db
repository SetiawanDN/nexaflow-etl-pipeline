CREATE TABLE cars (
    car_id VARCHAR(10) PRIMARY KEY,
    brand VARCHAR(50),
    model VARCHAR(50),
    year INT,
    color VARCHAR(20),
    engine_type VARCHAR(20),
    transmission VARCHAR(20),
    price NUMERIC,
    quantity_in_stock INT,
    status VARCHAR(20)
);

CREATE TABLE customers (
    customer_id VARCHAR(10) PRIMARY KEY,
    first_name VARCHAR(50),
    last_name VARCHAR(50),
    gender VARCHAR(10),
    age INT,
    job_role VARCHAR(50),
    phone VARCHAR(20),
    email VARCHAR(100),
    city VARCHAR(50),
    state VARCHAR(50),
    region VARCHAR(20)
);

CREATE TABLE sales (
    sale_id VARCHAR(10) PRIMARY KEY,
    customer_id VARCHAR(10),
    car_id VARCHAR(10),
    sale_date DATE,
    quantity INT,
    sale_price NUMERIC,
    payment_method VARCHAR(30),
    salesperson VARCHAR(50)
);